--- /dev/null
+++ b/src/afterword-language-policy.h
@@ -0,0 +1,9 @@
+#pragma once
+
+static inline int afterword_select_auto_language(
+        int detected, const float * probabilities, int english, int chinese, bool restricted) {
+    if (!restricted || detected == english || detected == chinese) {
+        return detected;
+    }
+    return probabilities[chinese] > probabilities[english] ? chinese : english;
+}
